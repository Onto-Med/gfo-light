    "@id" : "https://w3id.org/gfo-core/TimeEntity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "time of"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/gfo-core/ConcreteIndividual"
  } ]
}, {
