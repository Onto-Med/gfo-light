  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "X temporal part of Y: X starts Y or X finishes Y or X during Y"
  } ]
}, {
  "@id" : "https://w3id.org/gfo-core/temporallyContains",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
